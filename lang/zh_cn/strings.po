msgstr "人口几近绝灭"

#: script/events/outside.js:224
msgid "A Beast Attack"
msgstr "野兽来袭"

#: script/events/outside.js:231
msgid "a pack of snarling beasts pours out of the trees."
msgstr "一群咆哮的野兽冲出丛林"

